{
  "name": "com.carnet.noteapp",
  "displayName": "ViteVendre",
  "version": "1.0.0",
  "description": "Application vidéo ViteVendre : publication, streaming adaptatif HLS.",
  "main": "www/index.html",
  "scripts": {
    "test": "node scripts/check.js",
    "vendor": "node scripts/copy-vendor.js",
    "postinstall": "npm run vendor",
    "dev": "cordova run browser -- --live-reload",
    "android": "cordova run android",
    "emulator": "cordova run android --emulator",
    "web": "cordova run browser -- --live-reload"
  },
  "keywords": [
    "ecosystem:cordova"
  ],
  "author": "ViteVendre",
  "license": "Apache-2.0",
  "devDependencies": {
    "cordova-android": "^15.1.0",
    "cordova-browser": "^7.0.0"
  },
  "cordova": {
    "platforms": [
      "android",
      "browser"
    ],
    "plugins": {
      "cordova-plugin-camera": {
        "ANDROIDX_CORE_VERSION": "1.6.+"
      },
      "cordova-plugin-media-capture": {},
      "cordova-plugin-file": {},
      "cordova-plugin-network-information": {},
      "cordova-plugin-inappbrowser": {},
      "cordova-plugin-statusbar": {}
    }
  },
  "dependencies": {
    "cordova-plugin-camera": "8.0.0",
    "cordova-plugin-file": "8.1.3",
    "cordova-plugin-inappbrowser": "7.0.0",
    "cordova-plugin-media-capture": "6.0.0",
    "cordova-plugin-network-information": "3.1.0",
    "cordova-plugin-statusbar": "4.0.0",
    "hls.js": "^1.7.4"
  }
}
